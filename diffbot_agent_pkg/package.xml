<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>diffbot_agent</name>
  <version>0.0.1</version>
  <description>LLM-based skill-library agent for the diffbot AGV: NL command parsing, movement skills, vision query, emergency stop, and rosbridge-facing web interface</description>
  <maintainer email="antor@example.com">Antor</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>python3-opencv</depend>
  <depend>python3-yaml</depend>

  <exec_depend>python3-requests</exec_depend>
  <exec_depend>rosbridge_server</exec_depend>
  <exec_depend>robot_control_pkg</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
